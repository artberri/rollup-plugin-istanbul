{
	"name": "rollup-plugin-istanbul",
	"version": "5.0.1",
	"description": "Seamless integration between Rollup and Istanbul.",
	"keywords": [
		"coverage",
		"es2015",
		"es6",
		"istanbul",
		"rollup",
		"rollup-plugin"
	],
	"homepage": "https://github.com/artberri/rollup-plugin-istanbul",
	"bugs": {
		"url": "https://github.com/artberri/rollup-plugin-istanbul/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Alberto Varela",
		"email": "hello@albertovarela.net",
		"url": "https://www.albertovarela.net"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/artberri/rollup-plugin-istanbul.git"
	},
	"files": [
		"src",
		"dist",
		"index.d.ts",
		"index.d.cts",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/rollup-plugin-istanbul.cjs",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./index.d.ts",
				"default": "./dist/rollup-plugin-istanbul.mjs"
			},
			"require": {
				"types": "./index.d.cts",
				"default": "./dist/rollup-plugin-istanbul.cjs"
			}
		}
	},
	"scripts": {
		"prebuild": "rm -rf dist/*",
		"build": "rollup -c",
		"test": "node --test test/plugin.test.js test/dist.test.js",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"check": "oxlint --deny-warnings && oxfmt --check",
		"prepare": "pnpm run build",
		"prepack": "pnpm run check && pnpm run build && pnpm test"
	},
	"dependencies": {
		"@rollup/pluginutils": "^5.5.1",
		"istanbul-lib-instrument": "^6.0.3"
	},
	"devDependencies": {
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"rollup": "^4.68.0"
	},
	"peerDependencies": {
		"rollup": "^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"rollup": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@12.18.0"
}
